#!/usr/bin/env python3
"""Client-side age inbox. The URL is the secret.

  https://thehumanworks.github.io/age-inbox/#to=<age1>&c=<pack>

No server. `to` is the public key. Writers seal (and can append) without
the private key. Only the matching identity can open.

The vault is whatever you encrypt: typically a .env. Names live inside
that text, so they are zstd-compressed and age-encrypted with the values.
Nothing about the vault is put in the URL except ciphertext.

  inbox init
  inbox invite
  inbox seal [--url URL]     # vault on stdin; appends if URL has c=
  inbox open URL
  inbox compact URL          # needs identity; prints a shorter URL
  inbox to URL
"""

from __future__ import annotations

import argparse
import base64
import json
import os
import shutil
import struct
import subprocess
import sys
import urllib.parse
from pathlib import Path

SCHEME = "ageinbox"
VERSION = "1"
DEFAULT_BASE = "https://thehumanworks.github.io/age-inbox/"
PACK_MAGIC = b"AIP1"
ZSTD_MAGIC = b"\x28\xb5\x2f\xfd"


def die(msg: str, code: int = 2) -> None:
    print(f"inbox: {msg}", file=sys.stderr)
    raise SystemExit(code)


def not_found() -> None:
    print("404 Not Found", file=sys.stderr)
    raise SystemExit(1)


def require_tools(*, need_zstd: bool = False) -> None:
    if shutil.which("age") is None or shutil.which("age-keygen") is None:
        die("age and age-keygen must be on PATH")
    if need_zstd and shutil.which("zstd") is None:
        die("zstd must be on PATH")


def identity_path() -> Path:
    override = os.environ.get("AGE_INBOX_IDENTITY")
    if override:
        return Path(override).expanduser()
    return Path.cwd() / ".age-inbox" / "identity"


def recipient_from_identity(path: Path) -> str:
    if not path.is_file():
        die(f"no identity at {path}. Run: inbox init")
    for line in path.read_text(encoding="utf-8").splitlines():
        if line.startswith("# public key:"):
            rec = line.split(":", 1)[1].strip()
            if rec.startswith("age1"):
                return rec
    proc = subprocess.run(
        ["age-keygen", "-y", str(path)],
        check=True,
        capture_output=True,
        text=True,
    )
    rec = proc.stdout.strip()
    if not rec.startswith("age1"):
        die(f"could not read recipient from {path}")
    return rec


def b64url_encode(data: bytes) -> str:
    return base64.urlsafe_b64encode(data).decode("ascii").rstrip("=")


def b64url_decode(text: str) -> bytes:
    pad = "=" * (-len(text) % 4)
    return base64.urlsafe_b64decode(text + pad)


def parse_url(url: str) -> dict[str, str]:
    raw = url.strip()
    if raw.startswith(f"{SCHEME}:"):
        rest = raw[len(SCHEME) + 1 :]
        if rest.startswith("//"):
            rest = rest[2:]
        if rest.startswith(f"{VERSION}?"):
            query = rest[len(VERSION) + 1 :]
        elif rest.startswith("?"):
            query = rest[1:]
        else:
            query = rest.split("?", 1)[1] if "?" in rest else rest
        qs = urllib.parse.parse_qs(query, keep_blank_values=True)
    else:
        parts = urllib.parse.urlsplit(raw)
        qs = urllib.parse.parse_qs(parts.query)
        if parts.fragment:
            frag = parts.fragment
            if frag.startswith("?"):
                frag = frag[1:]
            qs = {**qs, **urllib.parse.parse_qs(frag)}
    out: dict[str, str] = {}
    for key in ("to", "c"):
        vals = qs.get(key)
        if vals:
            out[key] = vals[0]
    if "to" not in out or not out["to"].startswith("age1"):
        die("url must include to=age1… (the public key)")
    return out


def inbox_base() -> str | None:
    raw = os.environ.get("AGE_INBOX_BASE")
    if raw == "":
        return None
    if raw:
        return raw if raw.endswith("/") else raw + "/"
    return DEFAULT_BASE


def build_url(*, to: str, ciphertext: bytes | None = None) -> str:
    q: list[tuple[str, str]] = [("to", to)]
    if ciphertext is not None:
        q.append(("c", b64url_encode(ciphertext)))
    query = urllib.parse.urlencode(q, safe="")
    base = inbox_base()
    if base is None:
        return f"{SCHEME}:{VERSION}?{query}"
    return f"{base}#{query}"


def encrypt(plaintext: bytes, recipient: str) -> bytes:
    proc = subprocess.run(
        ["age", "-r", recipient],
        input=plaintext,
        capture_output=True,
        check=False,
    )
    if proc.returncode != 0:
        die(proc.stderr.decode() or "age encrypt failed", 1)
    return proc.stdout


def decrypt(ciphertext: bytes, ident: Path) -> bytes:
    proc = subprocess.run(
        ["age", "-d", "-i", str(ident)],
        input=ciphertext,
        capture_output=True,
        check=False,
    )
    if proc.returncode != 0:
        not_found()
    return proc.stdout


def zstd_compress(data: bytes) -> bytes:
    proc = subprocess.run(
        ["zstd", "-19", "-q", "-c"],
        input=data,
        capture_output=True,
        check=False,
    )
    if proc.returncode != 0:
        die(proc.stderr.decode() or "zstd compress failed", 1)
    return proc.stdout


def zstd_decompress(data: bytes) -> bytes:
    proc = subprocess.run(
        ["zstd", "-d", "-q", "-c"],
        input=data,
        capture_output=True,
        check=False,
    )
    if proc.returncode != 0:
        die(proc.stderr.decode() or "zstd decompress failed", 1)
    return proc.stdout


def split_pack(blob: bytes) -> list[bytes]:
    if blob.startswith(PACK_MAGIC):
        items: list[bytes] = []
        off = len(PACK_MAGIC)
        while off < len(blob):
            if off + 4 > len(blob):
                die("truncated pack")
            (n,) = struct.unpack_from(">I", blob, off)
            off += 4
            if n < 0 or off + n > len(blob):
                die("truncated pack frame")
            items.append(blob[off : off + n])
            off += n
        if not items:
            die("empty pack")
        return items
    return [blob]


def join_pack(items: list[bytes]) -> bytes:
    if len(items) == 1:
        return items[0]
    out = bytearray(PACK_MAGIC)
    for item in items:
        out.extend(struct.pack(">I", len(item)))
        out.extend(item)
    return bytes(out)


def encode_vault(text: str) -> bytes:
    return zstd_compress(text.encode("utf-8"))


def secrets_to_env(secrets: list[dict[str, str]]) -> str:
    lines = []
    for item in secrets:
        name = item.get("n") or ""
        val = item.get("v") or ""
        if name:
            lines.append(f"{name}={val}")
        else:
            lines.append(val)
    return "\n".join(lines)


def decode_vault(plain: bytes) -> str:
    try:
        if not plain.startswith(ZSTD_MAGIC):
            raise ValueError()
        data = zstd_decompress(plain)
        text = data.decode("utf-8")
        try:
            obj = json.loads(text)
        except json.JSONDecodeError:
            return text
        if isinstance(obj, dict) and isinstance(obj.get("secrets"), list):
            out = []
            for item in obj["secrets"]:
                if isinstance(item, dict):
                    out.append({"n": str(item.get("n") or ""), "v": str(item.get("v") or "")})
            if out:
                return secrets_to_env(out)
        return text
    except SystemExit:
        raise
    except Exception:
        not_found()


def open_all(blob: bytes, ident: Path) -> str:
    chunks = [decode_vault(decrypt(item, ident)) for item in split_pack(blob)]
    parts = [c.strip("\n") for c in chunks if c.strip()]
    return "\n\n".join(parts) + ("\n" if parts else "")


def warn_url(url: str) -> None:
    if len(url) > 2000:
        print(
            f"inbox: warning: url is {len(url)} chars; some browsers and chats will truncate it",
            file=sys.stderr,
        )


def cmd_init(_args: argparse.Namespace) -> int:
    require_tools()
    path = identity_path()
    if path.exists():
        print(f"identity already exists: {path}", file=sys.stderr)
        print(recipient_from_identity(path))
        return 0
    path.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run(["age-keygen", "-o", str(path)], check=True)
    path.chmod(0o600)
    rec = recipient_from_identity(path)
    print(f"wrote {path}", file=sys.stderr)
    print(rec)
    return 0


def cmd_invite(args: argparse.Namespace) -> int:
    to = args.to or recipient_from_identity(identity_path())
    print(build_url(to=to))
    return 0


def cmd_seal(args: argparse.Namespace) -> int:
    require_tools(need_zstd=True)
    existing = b""
    if args.url:
        parsed = parse_url(args.url)
        to = parsed["to"]
        if parsed.get("c"):
            existing = b64url_decode(parsed["c"])
    else:
        to = args.to or recipient_from_identity(identity_path())
    plaintext = sys.stdin.buffer.read()
    if not plaintext:
        die("stdin is empty")
    text = plaintext.decode("utf-8", "surrogateescape")
    cipher = encrypt(encode_vault(text), to)
    items = split_pack(existing) + [cipher] if existing else [cipher]
    url = build_url(to=to, ciphertext=join_pack(items))
    warn_url(url)
    print(url)
    return 0


def cmd_open(args: argparse.Namespace) -> int:
    require_tools(need_zstd=True)
    parsed = parse_url(args.url)
    if "c" not in parsed:
        die("url has no ciphertext (c=). This is an invite. Seal a vault first.")
    ident = identity_path()
    if not ident.is_file():
        die(f"no identity at {ident}. Run: inbox init")
    sys.stdout.write(open_all(b64url_decode(parsed["c"]), ident))
    return 0


def cmd_compact(args: argparse.Namespace) -> int:
    require_tools(need_zstd=True)
    parsed = parse_url(args.url)
    if "c" not in parsed:
        die("url has no ciphertext (c=). Nothing to compact.")
    ident = identity_path()
    if not ident.is_file():
        die(f"no identity at {ident}. Run: inbox init")
    vault = open_all(b64url_decode(parsed["c"]), ident)
    to = parsed["to"]
    blob = encrypt(encode_vault(vault), to)
    url = build_url(to=to, ciphertext=blob)
    print(f"inbox: {len(parsed['c'])} → {len(url)} chars", file=sys.stderr)
    warn_url(url)
    print(url)
    return 0


def cmd_to(args: argparse.Namespace) -> int:
    print(parse_url(args.url)["to"])
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="inbox", description=__doc__)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("init", help="generate a local age identity")

    inv = sub.add_parser("invite", help="print a write-only URL that carries your public key")
    inv.add_argument("--to", help="recipient; default is the local identity")

    s = sub.add_parser("seal", help="encrypt a vault from stdin and print a URL")
    s.add_argument("--url", help="invite or existing inbox URL (uses its to=, appends c=)")
    s.add_argument("--to", help="recipient if you are not passing --url")

    o = sub.add_parser("open", help="decrypt a URL to stdout")
    o.add_argument("url")

    c = sub.add_parser("compact", help="merge packed vaults into one zstd age file")
    c.add_argument("url")

    t = sub.add_parser("to", help="print the public key from a URL")
    t.add_argument("url")
    return p


def main() -> int:
    args = build_parser().parse_args()
    if args.cmd == "init":
        return cmd_init(args)
    if args.cmd == "invite":
        return cmd_invite(args)
    if args.cmd == "seal":
        return cmd_seal(args)
    if args.cmd == "open":
        return cmd_open(args)
    if args.cmd == "compact":
        return cmd_compact(args)
    if args.cmd == "to":
        return cmd_to(args)
    die("unknown command")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
